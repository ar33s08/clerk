09, 6788467, 6788834, 6798771, 7246451, 7797758, 7798827, 7838049, 8212255, 8747509, 8753945, 9042814, 9376510, 9385633, 9399590, 9801683], "download_url": "https://www.supremecourt.ohio.gov/rod/docs/pdf/13/2023/2023-Ohio-2323.pdf", "id": 9882998, "joined_by_ids": [], "local_path": "pdf/2023/06/13/langer_v._ohio_state_univ._office_of_univ._compliance__integrity.pdf", "meta": {"timestamp": "2025-11-29T04:05:58.564403Z", "date_created": "2023-10-05T22:23:02.066400Z"}, "ordering_key": null, "per_curiam": false, "sha1": "ade1604837afd1e51b873dc769beec755e0ec32a", "snippet": "for\nthe remaining request based on the <mark>attorney-client privilege</mark>. Complaint, filed March 17,\n2023, at pp", "type": "combined-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [9882998], "source": "C", "status": "Published", "suitNature": "", "syllabus": "Public Records Unauthorized Practice of Law Attorney-Client Privilege R.C. 149.43(C)(1) R.C. 2743.75(D)(1) R.C. 4705.01 A party is not \"aggrieved\" by the denial of another person's public records request unless the other person was the party's designee A non-lawyer's filing of a R.C. 2743.75 complaint on behalf of another person or an entity is the unauthorized practice of law a R.C. 2743.75 complaint should not be dismissed for failure to attach documents related to the records request if the missing documents are put into the record of the case Public office's burden of proving the applicability of an exemption from the general duty to provide access to records Burden of proving the elements of attorney-client privilege A signed, final, contract with adverse party is not covered by the attorney-client privilege."}, {"absolute_url": "/opinion/5305822/jacobs-v-equity-trust-co/", "attorney": "", "caseName": "Jacobs v. Equity Trust Co.", "caseNameFull": "", "citation": ["2021 Ohio 4349"], "citeCount": 0, "cluster_id": 5305822, "court": "Ohio Court of Appeals", "court_citation_string": "Ohio Ct. App.", "court_id": "ohioctapp", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2021-12-13", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "20CA011701", "docket_id": 61612210, "judge": "Hensal", "lexisCite": "", "meta": {"timestamp": "2024-06-22T04:37:41.144387Z", "date_created": "2021-12-13T17:12:15.908767Z", "score": {"bm25": 77.382034}}, "neutralCite": "2021 Ohio 4349", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [700645, 2705530, 4642767, 4647037], "download_url": "https://www.supremecourt.ohio.gov/rod/docs/pdf/9/2021/2021-Ohio-4349.pdf", "id": 5134373, "joined_by_ids": [], "local_path": "pdf/2021/12/13/jacobs_v._equity_trust_co..pdf", "meta": {"timestamp": "2025-10-22T23:51:59.919766Z", "date_created": "2021-12-13T17:12:15.918572Z"}, "ordering_key": null, "per_curiam": false, "sha1": "88abc39397d59cb37c85fbcae5e2afa4ff1fc62a", "snippet": "those documents were\n\nprotected by the <mark>attorney-client privilege</mark>. Id. at \u00b6 6. This Court agreed, reversing", "type": "combined-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [5134373], "source": "C", "status": "Published", "suitNature": "", "syllabus": "attorney-client privilege, bank examination privilege, de novo, legal advice, drafts, predominate purpose"}, {"absolute_url": "/opinion/4861033/hudson-v-greater-cleveland-regional-transit-auth/", "attorney": "", "caseName": "Hudson v. Greater Cleveland Regional Transit Auth.", "caseNameFull": "", "citation": ["168 N.E.3d 606", "2021 Ohio 576"], "citeCount": 1, "cluster_id": 4861033, "court": "Ohio Court of Appeals", "court_citation_string": "Ohio Ct. App.", "court_id": "ohioctapp", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2021-03-04", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "109405", "docket_id": 59704063, "judge": "E.T. Gallagher", "lexisCite": "", "meta": {"timestamp": "2025-11-26T18:10:57.111213Z", "date_created": "2021-03-04T16:13:04.035040Z", "score": {"bm25": 77.18804}}, "neutralCite": "2021 Ohio 576", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [110374, 118244, 118245, 931120, 3686857, 4228702, 4445690, 4647037], "download_url": "http://www.supremecourt.ohio.gov/rod/docs/pdf/8/2021/2021-Ohio-576.pdf", "id": 4664812, "joined_by_ids": [], "local_path": "pdf/2021/03/04/hudson_v._greater_cleveland_regional_transit_auth..pdf", "meta": {"timestamp": "2025-11-26T18:10:57.112768Z", "date_created": "2021-03-04T16:13:04.368158Z"}, "ordering_key": null, "per_curiam": false, "sha1": "333b678bded399242bc4a6de2e73c2cbcc2dc637", "snippet": "refused\n\nto produce on the grounds of <mark>attorney-client privilege</mark>. After a thorough review of\n\nthe facts", "type": "combined-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [4664812], "source": "C", "status": "Published", "suitNature": "", "syllabus": "Mandamus clear and convincing evidence summary judgment Civ.R. 56 de novo review R.C. 149.43 public record attorney-client privilege waiver disclosure. Appellee did not waive attorney-client privilege by disclosing the investigative report to its employees. The records sought by appellant in his public-records request were excepted from disclosure under Ohio's Public Records Act, and the trial court properly granted summary judgment in favor of appellee."}, {"absolute_url": "/opinion/4802508/yost-v-schaffner/", "attorney": "", "caseName": "Yost v. Schaffner", "caseNameFull": "", "citation": ["161 N.E.3d 857", "2020 Ohio 5127"], "citeCount": 2, "cluster_id": 4802508, "court": "Ohio Court of Appeals", "court_citation_string": "Ohio Ct. App.", "court_id": "ohioctapp", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2020-10-30", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "19 CA 000030", "docket_id": 18596800, "judge": "J. Wise", "lexisCite": "", "meta": {"timestamp": "2025-11-26T18:16:56.943858Z", "date_created": "2020-11-02T16:10:52.273232Z", "score": {"bm25": 76.858635}}, "neutralCite": "2020 Ohio 5127", "non_participating_judge_ids": [], "opinions": [{"author_id": 8149, "cites": [285656, 495529, 592156, 797135, 2691984, 2699076, 4412916], "download_url": "http://www.supremecourt.ohio.gov/rod/docs/pdf/5/2020/2020-Ohio-5127.pdf", "id": 4582855, "joined_by_ids": [], "local_path": "pdf/2020/10/30/yost_v._schaffner.pdf", "meta": {"timestamp": "2025-11-26T18:16:56.838050Z", "date_created": "2020-11-02T16:10:52.298214Z"}, "ordering_key": null, "per_curiam": false, "sha1": "3b98fd2dbbfbe77d069ab4346e23247706089aae", "snippet": "disclosure of material\n\nallegedly protected by <mark>attorney-client privilege</mark>, an interlocutory appeal will lie. Shaffer", "type": "combined-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [4582855], "source": "C", "status": "Published", "suitNature": "", "syllabus": "Attorney client privilege"}]}