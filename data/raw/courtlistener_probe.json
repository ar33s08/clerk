177 Ohio St. 3d 6"], "citeCount": 8, "cluster_id": 10680588, "court": "Ohio Supreme Court", "court_citation_string": "Ohio", "court_id": "ohio", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2024-10-24", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "2023-1457", "docket_id": 69305526, "judge": "", "lexisCite": "", "meta": {"timestamp": "2025-11-26T17:55:17.434765Z", "date_created": "2025-09-30T02:16:29.651188Z", "score": {"bm25": 79.57119}}, "neutralCite": "2024 Ohio 5063", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [590069, 2690499, 2692055, 3781087, 4681170, 4736563, 6114274, 6758110, 7089207, 8755514, 9387891, 11150768], "download_url": "https://www.supremecourt.ohio.gov/rod/docs/pdf/0/2024/2024-Ohio-5063.pdf", "id": 11147175, "joined_by_ids": [], "local_path": "pdf/2024/10/24/state_ex_rel._brinkman_v._toledo_city_school_dist._bd._of_edn._2.pdf", "meta": {"timestamp": "2025-12-08T05:43:26.288240Z", "date_created": "2025-09-30T02:16:29.691526Z"}, "ordering_key": null, "per_curiam": true, "sha1": "5f9d8e00b2c8d54035febd83bae44f59e041f83d", "snippet": "relator all text not protected by <mark>attorney-client\n        privilege</mark> in requested letter outlining scope", "type": "combined-opinion"}, {"author_id": null, "cites": [], "download_url": "https://www.supremecourt.ohio.gov/rod/docs/pdf/0/2024/2024-Ohio-5063.pdf", "id": 11080352, "joined_by_ids": [], "local_path": "pdf/2024/10/24/state_ex_rel._brinkman_v._toledo_city_school_dist._bd._of_edn._1.pdf", "meta": {"timestamp": "2026-05-14T21:02:14.050006Z", "date_created": "2025-06-19T16:20:20.144489Z"}, "ordering_key": null, "per_curiam": true, "sha1": "1c2b2dce027627eddc6f5ed9c9952a6591339901", "snippet": "relator all text not protected by <mark>attorney-client\n        privilege</mark> in requested letter outlining scope", "type": "combined-opinion"}, {"author_id": null, "cites": [], "download_url": "https://www.supremecourt.ohio.gov/rod/docs/pdf/0/2024/2024-Ohio-5063.pdf", "id": 10627172, "joined_by_ids": [], "local_path": "pdf/2024/10/24/state_ex_rel._brinkman_v._toledo_city_school_dist._bd._of_edn..pdf", "meta": {"timestamp": "2026-05-14T16:23:50.266994Z", "date_created": "2024-10-24T13:07:49.124283Z"}, "ordering_key": null, "per_curiam": true, "sha1": "91f28516c8a67ae19fd117d2e1641f45aac76b2f", "snippet": "relator all text not protected by <mark>attorney-client\n        privilege</mark> in requested letter outlining scope", "type": "combined-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [11147175, 11080352, 10627172], "source": "C", "status": "Published", "suitNature": "", "syllabus": "Mandamus\u2014Public-records requests\u2014Requests conveyed that relator was seeking particular records and therefore were not overbroad\u2014School district has clear legal duty to disclose to relator all text not protected by attorney-client privilege in requested letter outlining scope, terms, and conditions of legal representation of school district in its lawsuit against State\u2014School district failed to comply with obligation under R.C. 149.43(B) by improperly redacting from requested letter sentence not protected by attorney-client privilege, and school district delayed producing redacted copies of requested letters for more than four months\u2014Writ granted in part and denied in part and relator awarded court costs, $1,000 in statutory damages, and reasonable attorney's fees."}, {"absolute_url": "/opinion/9430938/a-morgan-bldg-group-llc-v-owners-ins-co/", "attorney": "", "caseName": "A. Morgan Bldg. Group, L.L.C. v. Owners Ins. Co.", "caseNameFull": "", "citation": ["224 N.E.3d 150", "2023 Ohio 3133"], "citeCount": 4, "cluster_id": 9430938, "court": "Ohio Court of Appeals", "court_citation_string": "Ohio Ct. App.", "court_id": "ohioctapp", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2023-09-06", "dateReargued": nul