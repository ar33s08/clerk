[], "opinions": [{"author_id": null, "cites": [1312033, 1376304, 1384129, 6720651], "download_url": "http://appellate.nccourts.org/opinions/?c=2&pdf=41210", "id": 9351038, "joined_by_ids": [], "local_path": "pdf/2022/12/29/wright_constr._servs..pdf", "meta": {"timestamp": "2025-10-27T05:36:53.566848Z", "date_created": "2022-12-29T14:05:04.442632Z"}, "ordering_key": null, "per_curiam": false, "sha1": "856a185273ab83a94ea9759a7065e54d673de0c0", "snippet": "underlying foreign action. However, since the <mark>attorney-client privilege</mark> always\n\n     belongs to the client, discovery", "type": "combined-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [9351038], "source": "C", "status": "Published", "suitNature": "", "syllabus": "Attorney-client privilege, interstate subpoena, subject matter jurisdiction."}, {"absolute_url": "/opinion/8246989/ne-monarch-constr-inc-v-morganti-ent-inc/", "attorney": "", "caseName": "N.E. Monarch Constr., Inc. v. Morganti Ent., Inc.", "caseNameFull": "", "citation": ["2022 Ohio 3551"], "citeCount": 0, "cluster_id": 8246989, "court": "Ohio Court of Appeals", "court_citation_string": "Ohio Ct. App.", "court_id": "ohioctapp", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2022-10-06", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "111236", "docket_id": 65405118, "judge": "Boyle", "lexisCite": "", "meta": {"timestamp": "2024-06-22T17:52:23.233405Z", "date_created": "2022-10-06T16:07:33.247237Z", "score": {"bm25": 78.43913}}, "neutralCite": "2022 Ohio 3551", "non_participating_judge_ids": [], "opinions": [{"author_id": 8055, "cites": [110374, 2690499, 2692016, 2692055, 4105166, 4212957, 6962340], "download_url": "https://www.supremecourt.ohio.gov/rod/docs/pdf/8/2022/2022-Ohio-3551.pdf", "id": 8212252, "joined_by_ids": [], "local_path": "pdf/2022/10/06/n.e._monarch_constr._inc._v._morganti_ent._inc..pdf", "meta": {"timestamp": "2025-07-09T01:42:32.884768Z", "date_created": "2022-10-06T16:07:33.259604Z"}, "ordering_key": null, "per_curiam": false, "sha1": "2ce9880b7ea2dfbadb37eba0c81e5baf9f0d04d7", "snippet": "Morganti Enterprise claims are protected by\n\n<mark>attorney-client privilege</mark>. For the reasons that follow, we affirm", "type": "combined-opinion"}], "panel_ids": [], "panel_names": [], "posture": "", "procedural_history": "", "scdb_id": "", "sibling_ids": [8212252], "source": "C", "status": "Published", "suitNature": "", "syllabus": "R.C. 2505.02(B)(4) interlocutory order final, appealable order motion to compel attorney-client privilege. Trial court's order compelling production of emails between appellants and counsel is reversed in part and affirmed in part. Emails between appellants and counsel that contain legal advice or were sent to obtain legal advice are confidential attorney-client communications protected by the attorney-client privilege. Emails between counsel for both parties are not protected attorney-client communications and must be produced."}, {"absolute_url": "/opinion/10680619/state-ex-rel-wells-v-lakota-local-schools-bd-of-edn/", "attorney": "", "caseName": "State ex rel. Wells v. Lakota Local Schools Bd. of Edn.", "caseNameFull": "", "citation": ["2024 Ohio 3316", "176 Ohio St. 3d 442"], "citeCount": 0, "cluster_id": 10680619, "court": "Ohio Supreme Court", "court_citation_string": "Ohio", "court_id": "ohio", "court_jurisdiction": null, "dateArgued": null, "dateFiled": "2024-09-03", "dateReargued": null, "dateReargumentDenied": null, "docketNumber": "2023-0190", "docket_id": 69123166, "judge": "", "lexisCite": "", "meta": {"timestamp": "2025-09-30T02:17:11.248589Z", "date_created": "2025-09-30T02:17:11.066730Z", "score": {"bm25": 77.95665}}, "neutralCite": "2024 Ohio 3316", "non_participating_judge_ids": [], "opinions": [{"author_id": null, "cites": [782344, 2690788, 3701779, 4396764, 4548075, 4636627, 6114274, 6114323, 6348197, 7088998, 8482838, 9393769, 98011