# CLERK env (all optional except as noted)
CLERK_LLM_BASE_URL=https://your-vllm-or-gateway.example/v1
CLERK_LLM_MODEL=qwen3.8-flash-next
CLERK_LLM_API_KEY=            *** required by hosted gateways
CLERK_API_TOKEN=              *** REQUIRED for the API server (fail-closed)
# CLERK_DATA_DIR=/data
# CLERK_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CLERK_LLM_DISABLE_THINKING=1   # hybrid-thinking vLLM servers
# CLERK_RERANK=1                 # opt-in LLM rerank lane
# CLERK_PRICE_IN=0.60            # USD per 1M prompt tokens (cost accounting)
# CLERK_PRICE_OUT=2.40
# CLERK_PRIV_THRESHOLD=0.6
# CLERK_VDR=0                    # visual document retrieval lane (stub)
